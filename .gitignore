# FCC downloads (large; re-fetch with scripts/fetch_fcc.py)
data/raw/*
!data/raw/.gitkeep
# census block boundaries (113 MB for the Bay Area; re-fetch with scripts/fetch_blocks.py).
# San Francisco is kept because the unit tests use it.
data/blocks/*
!data/blocks/06075.geojson
# site/data/overview.js and site/data/blocks/ are generated by scripts/build_map.py but
# committed so GitHub Pages can deploy the FCC-derived data without re-downloading it.
# Building footprints (~200 MB for the Bay Area) are generated in the Pages workflow
# from public sources and cached there; build them locally with `make buildings`.
site/data/buildings/
__pycache__/
*.pyc
.venv/
